# ── Supabase Credentials ─────────────────────────────────────────────────────────
# Found in: Supabase Dashboard -> Project Settings -> API
#
# SECURITY NOTE: The anon key is intentionally client-side safe — it is a
# publishable key restricted by Row Level Security (RLS) policies on every table.
# Never put the Supabase SERVICE ROLE key here under any circumstances.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Flask Backend API URL ─────────────────────────────────────────────────────────
# Local development: http://localhost:5000/api
# Production: https://your-backend-domain.com/api
VITE_API_URL=http://localhost:5000/api
