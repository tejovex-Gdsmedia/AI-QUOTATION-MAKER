# ── Flask Configuration ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-strong-random-secret-key
# IMPORTANT: Set to False in production. True only for local development.
FLASK_DEBUG=False
PORT=5000

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL. The API will reject requests from any other origin.
# Example: https://yourapp.vercel.app or http://localhost:5173 for local dev
FRONTEND_URL=https://your-frontend-domain.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────────
# Optional: provide a Redis URL for shared rate limiting across multiple workers.
# Without this, in-process memory is used (limits are per-worker, not global).
# REDIS_URL=redis://localhost:6379/0

# ── Gemini AI API Key ────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Leave blank to run in deterministic mock/fallback mode (no AI generation)
GEMINI_API_KEY=your-gemini-api-key-here

# ── Supabase Postgres Database URL ───────────────────────────────────────────────
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Transaction" pooler URI (port 6543) for serverless/short-lived connections
DATABASE_URL=postgresql://postgres.[your-project-id]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Supabase Admin Credentials (server-side only — NEVER expose client-side) ─────
# Required for account deletion via the Supabase Admin REST API.
# SUPABASE_URL: found in Dashboard -> Project Settings -> API -> Project URL
# SUPABASE_SERVICE_ROLE_KEY: found in Dashboard -> Project Settings -> API -> Service Role key
# WARNING: The service role key bypasses all RLS. Keep it server-side only.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
